# Secrets & credentials - NEVER commit
secrets/
*.env
.env*
*.pem
*.key
*token*
*secret*
*wallet*
*seed*
*private*

# Local runtime
__pycache__/
*.pyc
.venv/
venv/
node_modules/
var/
*.heartbeat.json
.DS_Store
Thumbs.db

# Large or transient
*.log
artifacts/raw/
traces/raw/

# Evaluation scratch artifacts can contain local diagnostics; commit only
# explicitly sanitized evaluation summaries.
evaluations/*-FAIL.json
evaluations/*-samples.json
evaluations/*-start.json
