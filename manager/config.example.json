{
  "actor": "local-machine-manager",
  "objective": "General autonomous worker supervision",
  "poll_interval_s": 2,
  "state_db": "../var/machine_manager.sqlite3",
  "lock_file": "../var/machine_manager.lock",
  "manager_log_file": "../var/manager.log",
  "env_file": "../secrets/manager.env",
  "event_retention": 5000,
  "public_event_limit": 500,
  "queue_dispatch": {
    "enabled": false,
    "background": true,
    "limit": 4,
    "defer_delay_s": 300,
    "max_attempts": 3,
    "max_workers": 1,
    "max_in_flight": 1
  },
  "research_worker": {
    "enabled": false,
    "mode": "ollama",
    "model": "qwen3.5:4b",
    "base_url": "http://127.0.0.1:11434",
    "artifact_dir": "../var/research",
    "model_timeout_s": 30,
    "source_timeout_s": 15,
    "max_source_bytes": 120000,
    "max_sources": 3
  },
  "verification_worker": {
    "enabled": false,
    "root": "..",
    "artifact_dir": "../var/verification",
    "timeout_s": 120
  },
  "superteam_worker": {
    "enabled": false,
    "api_key_env": "SUPERTEAM_AGENT_API_KEY",
    "base_url": "https://superteam.fun",
    "artifact_dir": "../var/revenue",
    "timeout_s": 20,
    "max_bytes": 512000,
    "max_listings": 50
  },
  "recurring_tasks": [
    {
      "id": "machine-manager-capability-research",
      "kind": "research",
      "objective_id": "machine-manager-research",
      "interval_s": 21600,
      "enabled": false,
      "payload": {
        "question": "Identify one evidence-backed next integration milestone for Machine Manager from the current public platform documentation.",
        "sources": [
          {
            "title": "GitHub REST API documentation",
            "url": "https://docs.github.com/en/rest"
          },
          {
            "title": "OpenAI platform documentation",
            "url": "https://platform.openai.com/docs/overview"
          },
          {
            "title": "Anthropic documentation",
            "url": "https://docs.anthropic.com/en/docs/overview"
          }
        ]
      }
    },
    {
      "id": "revenue-lane-scout",
      "kind": "research",
      "objective_id": "revenue-opportunities",
      "interval_s": 86400,
      "enabled": false,
      "payload": {
        "question": "Find one currently visible, publicly documented software-revenue opportunity or explain why none can yet be selected; compare eligibility, deliverable, terms, and the next human-owned handoff.",
        "sources": [
          {
            "title": "Superteam Earn agent listings",
            "url": "https://superteam.fun/earn/agents/"
          },
          {
            "title": "IssueHunt terms",
            "url": "https://oss.issuehunt.io/terms"
          },
          {
            "title": "Algora terms",
            "url": "https://algora.io/legal/terms"
          }
        ]
      }
    },
    {
      "id": "machine-manager-verification",
      "kind": "verification",
      "objective_id": "machine-manager-verification",
      "interval_s": 43200,
      "enabled": false,
      "payload": {}
    }
  ],
  "autonomy": {
    "mode": "EXECUTE_AND_REPORT",
    "allow_account_enrollment": true,
    "allow_public_submissions": true,
    "allow_outreach": true,
    "honor_outreach_opt_out": true,
    "allow_paid_work": true,
    "allow_procurement_when_funded": true,
    "allow_tool_installation": true,
    "allow_gpu_when_protected_worker_idle": true,
    "respect_program_terms": true,
    "first_contact_disclosure": "Hello — I’m an AI assistant acting on Jaron’s behalf."
  },
  "evidence": {
    "audit_interval_s": 86400,
    "worker_profiles": [
      {
        "id": "machine-manager-runtime",
        "provider": "local",
        "model": "Machine Manager",
        "model_version": "0.2",
        "verified_model_version": "0.2",
        "last_verified": "2026-08-30T00:00:00Z",
        "capabilities": [
          {
            "id": "process-supervision",
            "status": "TESTED_PASS",
            "summary": "Synthetic reliability scenarios exercise health checks and bounded recovery.",
            "evidence_id": "scenario-suite-v1",
            "observed_at": "2026-08-30T00:00:00Z"
          },
          {
            "id": "sanitized-publication",
            "status": "TESTED_PASS",
            "summary": "Only allowlisted telemetry fields are sent to the public dashboard.",
            "evidence_id": "telemetry-tests-v1",
            "observed_at": "2026-08-30T00:00:00Z"
          }
        ]
      }
    ],
    "constraint_audits": [
      {
        "id": "machine-manager-source",
        "label": "Machine Manager source",
        "path": "..",
        "enabled": true,
        "interval_s": 86400,
        "max_files": 1200,
        "max_findings": 250
      }
    ]
  },
  "public_upload": {
    "enabled": false,
    "owner": "JaronKBragg7337",
    "repository": "MachineManager",
    "branch": "main",
    "path_prefix": "dashboard/data",
    "token_env": "MACHINE_MANAGER_GITHUB_TOKEN",
    "interval_s": 120
  },
  "agents": [
    {
      "id": "local-manager-brain",
      "role": "health-review-specialist",
      "focus": "Review worker health, resource evidence, and bounded recovery signals.",
      "provider": "ollama",
      "model": "qwen3.5:4b",
      "base_url": "http://127.0.0.1:11434",
      "enabled": false,
      "interval_s": 300,
      "timeout_s": 15,
      "keep_gpu_free": true
    }
  ],
  "workstreams": [
    {
      "id": "machine-manager-evidence",
      "objective_id": "machine-manager-governance",
      "title": "Machine Manager evidence audit",
      "lane": "Capability evidence",
      "owner": "evidence-coordinator",
      "summary": "Maps configured source into review leads without changing source files.",
      "next_action": "Continue the saved scan window, then review the evidence-backed leads.",
      "source": {
        "kind": "constraint_audit",
        "id": "machine-manager-source"
      }
    }
  ],
  "jobs": [
    {
      "id": "synthetic-worker-001",
      "objective_id": "synthetic-reliability",
      "objective": "Synthetic worker reliability check",
      "max_restarts": 3,
      "retry_reset_after_s": 3600,
      "worker": {
        "id": "synthetic-001",
        "type": "SyntheticWorker",
        "command": [
          "python",
          "-m",
          "manager.synthetic_worker",
          "--mode",
          "run",
          "--heartbeat-file",
          "../var/synthetic.heartbeat.json",
          "--interval",
          "0.2"
        ],
        "cwd": "..",
        "heartbeat_file": "../var/synthetic.heartbeat.json",
        "heartbeat_max_age_s": 1,
        "startup_grace_s": 1,
        "pid_file": "../var/synthetic.pid.json"
      }
    }
  ]
}
